# ===== AWS 기본 설정 =====
aws_region = "ap-northeast-2"
environment = "dev"

# ===== VPC 설정 =====
vpc_cidr = "10.0.0.0/16"

# ===== EKS 클러스터 설정 =====
cluster_name = "erpulse-cluster"
cluster_version = "1.34"

# ===== EKS 워커 노드 설정 =====
node_group_desired_size = 2
node_group_max_size     = 4
node_instance_type      = "t3.medium"

# ===== RDS PostgreSQL 설정 =====
db_name                = "erpulse"
db_username            = "postgres"
db_password            = "CHANGE_ME"  # 로컬에서 변경
db_allocated_storage   = 20
db_instance_class      = "db.t3.micro"

# ===== ECR 설정 =====
ecr_repository_name       = "erpulse-api"
ecr_image_tag_mutability  = "MUTABLE"

# ===== api key 설정 =====
public_api_key     = "CHANGE_ME"  # data.go.kr에서 발급받은 키
kakao_rest_api_key = "CHANGE_ME"  # 카카오 디벨로퍼스(developers.kakao.com)에서 발급받은 REST API 키

# ===== 알림 설정 =====
slack_webhook_url = "CHANGE_ME"  # Alertmanager -> Slack 알림용. 필수 변수라 값이 없으면 apply 실패. 알림 안 쓸 거면 더미 URL이라도 입력
